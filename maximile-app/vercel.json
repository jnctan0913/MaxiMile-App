{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/assets/node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/:filename",
      "destination": "/fonts/Ionicons.ttf"
    },
    {
      "source": "/((?!fonts|assets|_expo|favicon).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*\\.shortcut)",
      "headers": [
        { "key": "Content-Type", "value": "application/x-apple-shortcuts" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"MaxiMile.shortcut\"" }
      ]
    }
  ]
}
